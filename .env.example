POSTGRES_DB=mini_app_db
POSTGRES_USER=mini_app_user
POSTGRES_PASSWORD=mini_app_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@mini-app.local
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
SUPPORT_EMAIL_TO=
USE_MANIFEST_STATIC_FILES=false

# Selectel S3 (media/videos + static)
# Copy these values to .env and fill credentials.
USE_S3=true
SELECTEL_ACCESS_KEY=your_selectel_access_key
SELECTEL_SECRET_KEY=your_selectel_secret_key
SELECTEL_BUCKET_NAME=ktfit
SELECTEL_ENDPOINT_URL=https://s3.ru-3.storage.selcloud.ru
SELECTEL_REGION_NAME=ru-3
# Optional: custom domain pointing to the same bucket (for example storage.qarum.ru)
SELECTEL_CUSTOM_DOMAIN=
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600
AWS_S3_MAX_MEMORY_SIZE=104857600
REGISTRATION_ACCESS_KEY=12345678
AUTO_CREATE_ADMIN=1
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin12345
DEFAULT_USER_USERNAME=user
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=user12345
